# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_ACCESS_KEY: Optional master key for the Website & Server Management Dashboard.
# If left unset, you can claim and set your Owner Passkey directly on first launch.
ADMIN_ACCESS_KEY=""

# SESSION_SECRET: Secret used to sign private invite & admin session tokens.
SESSION_SECRET=""

# GITHUB_TOKEN: Personal Access Token (repo scope) for GitHub Server Sync.
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""
GITHUB_BRANCH="main"
GITHUB_DATA_PATH="server-data/myokbi-db.json"
GITHUB_LIVE_WATCH="true"
GITHUB_WEBHOOK_SECRET=""
